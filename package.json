{
  "name": "agent-quality-oss",
  "version": "0.3.0",
  "description": "Open-source MCP server for Korean construction quality management. Ontology-based reasoning over KCS/KDS, Quality Management Guidelines, KS, and project documents. Provided by Hwangryong Construction Co., Ltd. / Developed by Ratelworks Inc.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./tool-registry": {
      "types": "./build/tool-registry.d.ts",
      "import": "./build/tool-registry.js"
    },
    "./ontology/*": "./build/ontology/*"
  },
  "bin": {
    "agent-quality-oss": "build/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy:data && chmod +x build/cli.js build/index.js",
    "copy:data": "node -e \"import('node:fs/promises').then(async fs => { await fs.cp('src/ontology/graph', 'build/ontology/graph', { recursive: true }); await fs.cp('src/schemas/document-schemas.json', 'build/schemas/document-schemas.json'); })\"",
    "watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "start": "node build/index.js",
    "start:stdio": "node build/index.js --stdio",
    "cli": "node build/cli.js",
    "mcp:start": "node build/cli.js serve",
    "mcp:tools": "node build/cli.js tools",
    "mcp:viewer": "node build/cli.js viewer",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "validate:ontology": "tsx scripts/validate-ontology.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "audit": "tsx scripts/audit-ontology.ts",
    "coverage": "tsx scripts/coverage-matrix.ts",
    "check:oss-hygiene": "tsx scripts/verify/check-oss-hygiene.ts",
    "release:notes": "tsx scripts/release/extract-release-notes.ts --check",
    "release:notes:preview": "tsx scripts/release/extract-release-notes.ts",
    "prepublishOnly": "npm run check:oss-hygiene && npm run release:notes && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "construction",
    "quality-management",
    "ontology",
    "kcs",
    "kds",
    "korean-construction-standards",
    "ratelworks"
  ],
  "author": {
    "name": "Ratelworks Inc. (Director Hwang Ryong)",
    "url": "https://ratelworks.co.kr"
  },
  "contributors": [
    {
      "name": "Hwangryong Construction Co., Ltd.",
      "url": "https://ratelworks.co.kr"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratelworks/agent-quality-oss"
  },
  "bugs": {
    "url": "https://github.com/ratelworks/agent-quality-oss/issues"
  },
  "homepage": "https://github.com/ratelworks/agent-quality-oss#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "build",
    "src/ontology/graph",
    "src/schemas/document-schemas.json",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
