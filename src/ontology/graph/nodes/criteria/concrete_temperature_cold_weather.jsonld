{
  "@context": "../../context.jsonld",
  "@id": "criteria:concrete_temperature_cold_weather",
  "@type": "AcceptanceCriteria",
  "name": "한중 콘크리트 타설 온도 5~20 ℃ (KCS 14 20 40 3.3)",
  "aliases": [
    "한중 콘크리트 온도",
    "동절기 타설 온도"
  ],
  "_meta": {
    "operator": "between",
    "min": 5,
    "max": 20,
    "unit": "℃",
    "condition": "한중 콘크리트: 타설할 때의 콘크리트 온도는 구조물의 단면 치수, 기상 조건 등을 고려하여 5~20 ℃ 범위에서 정한다. 기상 조건이 가혹하거나 단면 두께가 300 mm 이하이면 타설할 때 최저 10 ℃ 이상을 확보한다.",
    "selectKeywords": [
      "한중",
      "동절기",
      "겨울철"
    ],
    "reference": "KCS 14 20 40 3.3 (1)",
    "sourceStatus": "verified",
    "verifiedAgainst": {
      "standard": "KCS 14 20 40",
      "edition": "2024-12-30",
      "clause": "3.3 (1)",
      "quotes": [
        "타설할 때의 콘크리트 온도는 구조물의 단면 치수, 기상 조건 등을 고려하여 (5 ~ 20) ℃의 범위에서 정하여야 한다",
        "타설 시 콘크리트의 최저온도를 10℃ 이상 확보하여야 한다"
      ]
    },
    "referenceVerified": true
  },
  "appliesTo": [
    "test:concrete_temperature"
  ],
  "derivedFrom": [
    "standard:kcs_14_20.40"
  ]
}
