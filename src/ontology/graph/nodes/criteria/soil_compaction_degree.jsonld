{
  "@context": "../../context.jsonld",
  "@id": "criteria:soil_compaction_degree",
  "@type": "AcceptanceCriteria",
  "name": "흙 다짐도 — 다짐 부위에 따라 다름",
  "aliases": [
    "다짐도 기준"
  ],
  "_meta": {
    "operator": "condition_dependent",
    "unit": "%",
    "condition": "다짐도 기준은 다짐 부위에 따라 다릅니다 — 흙쌓기 노체부는 최대건조밀도의 90 % 이상, 노상부는 95 % 이상입니다(KCS 11 20 20 3.2.16). 되메우기·구조물 뒤채움 등 그 밖의 부위는 해당 시방서와 설계도서를 따릅니다. 다짐 부위(노체·노상 등)를 알려 주세요.",
    "fallbackToProject": true,
    "reference": "KCS 11 20 20 3.2.16",
    "sourceStatus": "verified",
    "referenceVerified": false,
    "neededInputs": [
      "다짐 부위 (노체·노상 등)"
    ],
    "selectDefault": true,
    "verifiedAgainst": {
      "standard": "KCS 11 20 20",
      "edition": "2025-12-24",
      "clause": "3.2.16",
      "quotes": [
        "최대건조밀도의 90% 이상",
        "최대건조밀도의 95% 이상"
      ]
    },
    "inScopeKeywords": [
      "노상",
      "노체",
      "흙쌓기",
      "성토"
    ],
    "outOfScopeKeywords": [
      "보조기층",
      "기층",
      "표층",
      "동상방지층",
      "뒤채움",
      "되메우기",
      "되메움",
      "선택층",
      "필터층",
      "차수층",
      "포장층"
    ],
    "outOfScopeNote": "KCS 11 20 20 3.2.16 의 다짐도 기준은 흙쌓기의 노상·노체만 정한다. 보조기층·기층(KCS 44 50)·뒤채움·되메우기 등은 다른 기준이므로, 측정값이 그 대상의 값으로 적혀 있으면 이 기준으로 판정하지 않는다."
  },
