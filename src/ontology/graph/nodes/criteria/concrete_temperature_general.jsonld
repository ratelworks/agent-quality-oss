{
  "@context": "../../context.jsonld",
  "@id": "criteria:concrete_temperature_general",
  "@type": "AcceptanceCriteria",
  "name": "콘크리트 온도 — 일반 콘크리트는 정해진 조건에 따름 (KCS 14 20 10 표 3.5-2)",
  "_meta": {
    "operator": "condition_dependent",
    "unit": "℃",
    "condition": "일반 콘크리트의 받아들이기 검사에서 온도의 판정기준은 '정해진 조건에 적합할 것'입니다(KCS 14 20 10 표 3.5-2) — 정해진 수치 범위가 없어 공사시방서·배합 조건으로 판정합니다. 한중 콘크리트는 타설할 때 5~20 ℃(KCS 14 20 40 3.3 (1)), 서중 콘크리트는 35 ℃ 이하(KCS 14 20 41 3.3 (3))입니다. 한중·서중 여부나 공사시방서의 온도 조건을 알려 주세요.",
    "fallbackToProject": true,
    "reference": "KCS 14 20 10 3.5.3.1 표 3.5-2 (온도)",
    "sourceStatus": "verified",
    "verifiedAgainst": {
      "standard": "KCS 14 20 10",
      "edition": "2024-12-30",
      "clause": "3.5.3.1 표 3.5-2",
      "quotes": [
        "온도 | 온도측정 | 정해진 조건에 적합할 것"
      ]
    },
    "referenceVerified": true,
    "neededInputs": [
      "한중·서중 콘크리트 여부 또는 공사시방서의 온도 조건"
    ],
    "selectDefault": true
  },
  "appliesTo": [
    "test:concrete_temperature"
  ],
  "derivedFrom": [
    "standard:kcs_14_20.10.3_5_3_1"
  ]
}
